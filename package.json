{
  "name": "iongolem",
  "version": "0.1.0",
  "description": "An autonomous Minecraft bot built on Mineflayer, driven by the Claude CLI for decision-making.",
  "main": "bot.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bot.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "bot",
    "claude",
    "ai-agent",
    "llm"
  ],
  "author": "Ariel Vinograd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arielvino/ion-golem.git"
  },
  "bugs": {
    "url": "https://github.com/arielvino/ion-golem/issues"
  },
  "homepage": "https://github.com/arielvino/ion-golem#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "minecraft-data": "github:arielvino/node-minecraft-data#iongolem",
    "minecraft-protocol": "github:arielvino/node-minecraft-protocol#iongolem",
    "mineflayer": "github:arielvino/mineflayer#iongolem",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "github:arielvino/mineflayer-pathfinder#iongolem",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0",
    "prismarine-chunk": "github:arielvino/prismarine-chunk#iongolem",
    "prismarine-physics": "github:arielvino/prismarine-physics#iongolem"
  },
  "overrides": {
    "minecraft-data": "$minecraft-data",
    "minecraft-protocol": "$minecraft-protocol",
    "mineflayer": "$mineflayer",
    "mineflayer-pathfinder": "$mineflayer-pathfinder",
    "prismarine-chunk": "$prismarine-chunk",
    "prismarine-physics": "$prismarine-physics"
  }
}
