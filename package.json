{
  "name": "iongolem",
  "version": "0.1.0",
  "description": "An autonomous Minecraft bot built on Mineflayer, driven by the Claude CLI for decision-making.",
  "main": "bot.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bot.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "bot",
    "claude",
    "ai-agent",
    "llm"
  ],
  "author": "Ariel Vinograd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arielvino/ion-golem.git"
  },
  "bugs": {
    "url": "https://github.com/arielvino/ion-golem/issues"
  },
  "homepage": "https://github.com/arielvino/ion-golem#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "mineflayer": "github:arielvino/mineflayer#fix/set-passengers-events",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0"
  },
  "overrides": {
    "mineflayer-auto-eat": {
      "mineflayer": "$mineflayer"
    },
    "mineflayer-collectblock": {
      "mineflayer": "$mineflayer"
    },
    "mineflayer-pathfinder": {
      "mineflayer": "$mineflayer"
    },
    "mineflayer-pvp": {
      "mineflayer": "$mineflayer"
    },
    "mineflayer-tool": {
      "mineflayer": "$mineflayer"
    },
    "prismarine-chunk": "github:arielvino/prismarine-chunk#c9500be43e922b74c06852d76bfb7e3d2e89f071"
  }
}
